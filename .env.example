# HTTP port
PORT=5006

# Secret key for communication between services
SECRET_KEY=

# Master code
MASTER_CODE=

# Database — the database and tables are created automatically on first start
DB_TYPE=mysql
DB_HOST=localhost
DB_NAME=fiverscan
DB_USER=root
DB_PORT=3306
DB_PASS=
DB_LOGGING=false
DB_TIMEZONE=+00:00

# Field encryption key
CRYPT_KEY=

# Call range
CALL_RANGE=5

# AAS endpoint
AAS_ENDPOINT=
